# Copy to .env and adjust. Only the `vllm` profile reads these; the `demo`
# (mock) profile needs none of them.

# --- Model / vLLM ---------------------------------------------------------
# Model id served by vLLM and requested by the agent (must match).
LLM_MODEL=zai-org/GLM-5.2-FP8

# Hugging Face token to download the (gated/large) weights. Required for a real run.
HUGGING_FACE_HUB_TOKEN=

# GPUs to give vLLM. Use "all", or a count like 8, or a device list.
VLLM_GPU_COUNT=all
# tensor-parallel-size -- typically equal to the number of GPUs.
VLLM_TP_SIZE=1
# Context window vLLM allocates KV cache for. Lower it if you hit OOM.
VLLM_MAX_MODEL_LEN=8192

# Pin the vLLM image tag instead of :latest for reproducibility.
VLLM_IMAGE_TAG=latest
# Host port the vLLM endpoint is published on.
VLLM_HOST_PORT=8000
